---
import Base from '../../layouts/Base.astro';
import Tavle from '../../components/Tavle.astro';
import { alleEmner } from '../../lib/data';
const emner = await alleEmner();
---
<Base title="Tavle" aktiv="tavle">
  <div class="eyebrow">Alle emner · grupperet efter blik · sorteret efter relevans</div>
  <h1 class="page">Tavlen</h1>
  <p class="lead">{emner.length} emner i fagets kronologiske rækkefølge. Guld kant = relevans 5. Hold musen over et kort for den korte intro, klik for hele emnet.</p>
  <Tavle emner={emner} />
</Base>
